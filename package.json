{
  "name": "frigg",
  "private": true,
  "workspaces": [
    "web",
    "api"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "dev:api": "npm run dev --workspace=api",
    "build": "npm run build --workspace=api && npm run build --workspace=web",
    "migrate": "psql \"$DATABASE_URL\" -f",
    "test": "npm run test --workspace=api",
    "test:browser": "playwright test",
    "test:baikal": "tsx --test api/test/baikal.integration.ts",
    "test:postgres": "bash tests/integration/native-postgres.sh"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "argon2@0.41.1": true
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@playwright/test": "^1.65.1"
  },
  "overrides": {
    "express": {
      "qs": "^6.16.2"
    },
    "postcss": "^8.5.33"
  }
}
